{
  "name": "master-scoring",
  "productName": "Master Scoring",
  "version": "1.0.4",
  "description": "Master Scoring - ứng dụng chấm điểm code sinh viên (Local AI / Cloud AI)",
  "author": "Master Scoring",
  "license": "UNLICENSED",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/run-electron-vite.mjs dev",
    "build": "electron-vite build",
    "build:win": "node scripts/bump-version.mjs && npm run pack:win",
    "build:dir": "electron-vite build && electron-builder --dir --publish never",
    "preview": "node scripts/run-electron-vite.mjs preview",
    "icons": "node scripts/gen-icon.mjs",
    "fetch:runtime": "node scripts/fetch-runtime.mjs win",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "postinstall": "node node_modules/electron/install.js",
    "build:mac": "node scripts/bump-version.mjs && npm run pack:mac",
    "build:mac:arm64": "node scripts/bump-version.mjs && npm run pack:mac:arm64",
    "build:mac:x64": "node scripts/bump-version.mjs && npm run pack:mac:x64",
    "build:all": "node scripts/bump-version.mjs && npm run pack:win && npm run pack:mac",
    "fetch:runtime:mac": "node scripts/fetch-runtime.mjs mac",
    "pack:win": "node scripts/gen-icon.mjs && node scripts/fetch-runtime.mjs win && node scripts/gen-cert.mjs && electron-vite build && node scripts/builder.mjs --win nsis --x64 --publish never",
    "pack:mac": "node scripts/gen-icon.mjs && node scripts/fetch-runtime.mjs mac && electron-vite build && electron-builder --mac dmg --arm64 --x64 --publish never",
    "pack:mac:arm64": "node scripts/gen-icon.mjs && node scripts/fetch-runtime.mjs mac && electron-vite build && electron-builder --mac dmg --arm64 --publish never",
    "pack:mac:x64": "node scripts/gen-icon.mjs && node scripts/fetch-runtime.mjs mac && electron-vite build && electron-builder --mac dmg --x64 --publish never",
    "gen:cert": "node scripts/gen-cert.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-java": "6.0.2",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/language": "6.12.4",
    "@codemirror/legacy-modes": "6.5.4",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@fontsource/jetbrains-mono": "^5.2.5",
    "@lezer/highlight": "1.2.5",
    "bcryptjs": "3.0.3",
    "docx-preview": "^0.4.1",
    "exceljs": "4.4.0",
    "iconv-lite": "0.7.3",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sql.js": "1.14.2",
    "yauzl": "3.4.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sql.js": "1.4.11",
    "@types/yauzl": "3.4.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
